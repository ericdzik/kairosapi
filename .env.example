# ══════════════════════════════════════════════════════════════════════
# Kairos Backend — Variables d'environnement
# Copiez ce fichier en .env et renseignez les valeurs manquantes.
# Ne committez JAMAIS le fichier .env dans Git.
# ══════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────
APP_NAME="Kairos Business Group"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Logging ───────────────────────────────────────────────────────────
# En production sur Render, utiliser : stderr
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Base de données ───────────────────────────────────────────────────
# Production : pgsql  |  Développement local : sqlite ou pgsql
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=kairos_db
# DB_USERNAME=kairos_user
# DB_PASSWORD=

# ── Session / Cache / Queue ───────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

# ── Filesystem ────────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ── CORS — origines autorisées (séparées par virgules, ou "*") ────────
CORS_ALLOWED_ORIGINS=*

# ── Proxies de confiance (Render / reverse proxy) ────────────────────
# En prod sur Render mettre "*"  |  En local laisser vide
TRUSTED_PROXIES=
TRUSTED_HOSTS=

# ── Sanctum ───────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,127.0.0.1:8000

# ── Tokens Sanctum ───────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRY=15        # minutes
REFRESH_TOKEN_EXPIRY=10080    # minutes (7 jours)

# ── Sécurité login ───────────────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── Seeder : mot de passe admin initial ──────────────────────────────
# Uniquement utilisé lors du premier db:seed
# À changer immédiatement via /api/auth/change-password après le déploiement
ADMIN_PASSWORD=Kairos@2024!

# ── Mail (désactivé par défaut, logs uniquement) ─────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@kairos.app"
MAIL_FROM_NAME="${APP_NAME}"

# ── AWS S3 (optionnel — pour le stockage des photos clients) ─────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-3
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Redis (optionnel — non disponible sur le free tier Render) ────────
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ── Vite (frontend assets — non utilisé en prod API-only) ────────────
VITE_APP_NAME="${APP_NAME}"
